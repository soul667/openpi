IMAGE_NAME=openpi_portable
IMAGE_TAG=latest
CONTAINER_NAME=openpi

BASE_IMAGE=nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04@sha256:2d913b09e6be8387e1a10976933642c73c840c0b735f0bf3c28d97fc9bc422e0
UV_IMAGE=ghcr.io/astral-sh/uv:0.5.1

# Build 阶段 apt / uv / git 拉包使用. host 可以复用宿主 DNS/代理环境.
BUILD_NETWORK=host

# 如果 archive.ubuntu.com 解析慢/不通, 可换国内源, 例如:
# APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
# APT_MIRROR=http://mirrors.aliyun.com/ubuntu
APT_MIRROR=

# 如果 Docker build 容器内需要代理, 填你的代理端口, 例如 http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1

# lean: 不烘预训练权重 (镜像 ~15GB), 容器靠宿主机 OPENPI_ASSETS_DIR 挂载或运行时下载
# full: 把 docker_fix/_assets_stage/ 烘进镜像 (镜像 ~50GB), 离线机器拷过去就能跑
#       构建前先跑: bash docker_fix/prepare_assets.sh --apply
INCLUDE_ASSETS=lean

NETWORK_MODE=host
SHM_SIZE=32gb

GPU_COUNT=all
NVIDIA_VISIBLE_DEVICES=all

OPENPI_ASSETS_DIR=./_volumes/openpi_assets
DATASET_DIR=./_volumes/dataset
HF_CACHE_DIR=./_volumes/hf_cache
JAX_CACHE_DIR=./_volumes/jax_cache
SRC_DIR=..

WANDB_API_KEY=
HUGGING_FACE_HUB_TOKEN=

SERVER_ARGS=
SERVICE_COMMAND=bash
